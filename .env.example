# ============================================================
# Proveedor cloud, valores posibles: digitalocean, aws, gcp, local
# ============================================================
CLOUD_PROVIDER=local

# ============================================================
# Object storage (compatible con S3 para DO y AWS, GCS para GCP)
# ============================================================
STORAGE_BUCKET=ferreycorp-predictions
STORAGE_ENDPOINT=
# Si se usa DigitalOcean Spaces, descomentar y ajustar a la region elegida:
# STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_REGION=us-east-1
STORAGE_KEY=
STORAGE_SECRET=

# ============================================================
# Paths locales (se usan cuando CLOUD_PROVIDER=local)
# ============================================================
LOCAL_DATA_DIR=./data
LOCAL_PREDICTIONS_PATH=./data/predictions/predictions.parquet

# ============================================================
# Base de datos (Postgres, mismo formato de conexion en todas las nubes)
# ============================================================
DATABASE_URL=postgresql://user:pass@localhost:5432/ferreycorp

# ============================================================
# Cache (Redis)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# LLM (Anthropic, Claude)
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_TIMEOUT_SECONDS=30

# ============================================================
# App
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO
